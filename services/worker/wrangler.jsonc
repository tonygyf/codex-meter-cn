{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codex-meter-cn",
  "main": "src/cloudflare.ts",
  "compatibility_date": "2025-10-11",
  "workers_dev": true,
  "vars": { "CLOUD_ACCOUNT_MODE": "true" },
  "kv_namespaces": [
    { "binding": "SNAPSHOTS", "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID" }
  ],
  "durable_objects": { "bindings": [{ "name": "ACCOUNT", "class_name": "AccountVault" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AccountVault"] }],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
  // READ_TOKEN 与 WRITE_TOKEN 使用 wrangler secret put，禁止写在本文件。
}
