<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_background">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Codex 额度" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="14sp"/>
    <TextView android:id="@+id/widget_quotas" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="5h —   周 —" android:textColor="#BDE8D1" android:textStyle="bold" android:textSize="21sp"/>
    <TextView android:id="@+id/widget_resets" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="打开应用接入数据源" android:textColor="#FFFFFF" android:textSize="11sp" android:maxLines="2"/>
    <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="暂无快照 · 点击打开" android:textColor="#C9D9D1" android:textSize="10sp"/>
</LinearLayout>
